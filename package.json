{
  "name": "dsh-blender-mcp-bridge",
  "version": "0.1.0",
  "description": "DeepSeek Harness 到 Blender 官方 MCP add-on 套接字的桥接插件：握手、分级诊断、带检查点的执行、范围受限的误操作拦截，以及随包内置的离线 Blender 知识库",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./bundle/patch": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "buildKnowledge.js",
    "cordis.patch.yml",
    "lib",
    "jsconfig.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "skills",
    "knowledge"
  ],
  "scripts": {
    "check": "tsc --noEmit -p jsconfig.json",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "knowledge:fetch": "node buildKnowledge.js fetch",
    "knowledge:build": "node buildKnowledge.js build",
    "knowledge:verify": "node buildKnowledge.js verify",
    "test": "node --test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "blender",
    "mcp",
    "bridge"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
