{
  "name": "dsh-blender-mcp-bridge",
  "version": "0.1.0",
  "private": false,
  "description": "此项目是对 Deepseek Harness 开发的插件，旨在包装与桥接 Blender MCP Add-on，使 DSH 上的模型可便捷对接接入当前用户工作中的 Blender 以辅助创作，且满足基础安全需要。",
  "keywords": [
    "blender",
    "mcp",
    "model-context-protocol",
    "deepseek-harness",
    "dsh",
    "3d-modeling",
    "plugin"
  ],
  "homepage": "https://github.com/XuezuoYS/dsh-blender-mcp-bridge",
  "bugs": {
    "url": "https://github.com/XuezuoYS/dsh-blender-mcp-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XuezuoYS/dsh-blender-mcp-bridge.git"
  },
  "author": {
    "name": "xuezuoys",
    "url": "https://github.com/XuezuoYS"
  },
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "scripts": {
    "check": "tsc --noEmit -p jsconfig.json",
    "test": "node --test",
    "probe": "node diagnostics/probePreflight.js",
    "probe:syntax": "node diagnostics/probePythonSyntax.js",
    "probe:guard": "node diagnostics/probeGuardOffline.js",
    "probe:live": "node diagnostics/probeLive.js"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale",
    "lib",
    "helpers",
    "cordis.patch.yml",
    "requirements-analysis.txt",
    "scripts",
    "skills",
    "diagnostics",
    "test",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "7.0.2"
  }
}
